diff --git a/offline/packages/tpccalib/TpcGeometryOverride.cc b/offline/packages/tpccalib/TpcGeometryOverride.cc
new file mode 100644
index 0000000..118bca8
--- /dev/null
+++ b/offline/packages/tpccalib/TpcGeometryOverride.cc
@@ -0,0 +1,53 @@
+#include "TpcGeometryOverride.h"
+
+#include <g4detectors/PHG4TpcGeom.h>
+#include <g4detectors/PHG4TpcGeomContainer.h>
+
+#include <fun4all/Fun4AllReturnCodes.h>
+#include <phool/PHCompositeNode.h>
+#include <phool/getClass.h>
+
+#include <iostream>
+
+TpcGeometryOverride::TpcGeometryOverride(const std::string &name)
+  : SubsysReco(name)
+{
+}
+
+int TpcGeometryOverride::InitRun(PHCompositeNode *topNode)
+{
+  auto *geomContainer = findNode::getClass<PHG4TpcGeomContainer>(topNode, "TPCGEOMCONTAINER");
+  if (!geomContainer)
+  {
+    std::cout << Name() << "::InitRun - TPCGEOMCONTAINER not found" << std::endl;
+    return Fun4AllReturnCodes::ABORTRUN;
+  }
+
+  PHG4TpcGeom *layer20 = geomContainer->GetLayerCellGeom(20);
+  if (layer20)
+  {
+    std::cout << Name() << "::InitRun - input TPC geometry: place = ("
+              << layer20->get_place_x() << ", " << layer20->get_place_y() << ", " << layer20->get_place_z()
+              << ") cm, rot = (" << layer20->get_rot_x() << ", " << layer20->get_rot_y() << ", " << layer20->get_rot_z()
+              << ") rad" << std::endl;
+  }
+
+  const auto range = geomContainer->get_begin_end();
+  for (auto iter = range.first; iter != range.second; ++iter)
+  {
+    PHG4TpcGeom *geom = iter->second;
+    geom->set_place_x(m_place[0]);
+    geom->set_place_y(m_place[1]);
+    geom->set_place_z(m_place[2]);
+    geom->set_rot_x(m_rot[0]);
+    geom->set_rot_y(m_rot[1]);
+    geom->set_rot_z(m_rot[2]);
+  }
+
+  std::cout << Name() << "::InitRun - overridden TPC geometry: place = ("
+            << m_place[0] << ", " << m_place[1] << ", " << m_place[2]
+            << ") cm, rot = (" << m_rot[0] << ", " << m_rot[1] << ", " << m_rot[2]
+            << ") rad" << std::endl;
+
+  return Fun4AllReturnCodes::EVENT_OK;
+}
diff --git a/offline/packages/tpccalib/TpcGeometryOverride.h b/offline/packages/tpccalib/TpcGeometryOverride.h
new file mode 100644
index 0000000..1714a09
--- /dev/null
+++ b/offline/packages/tpccalib/TpcGeometryOverride.h
@@ -0,0 +1,60 @@
+#ifndef TPCCALIB_TPCGEOMETRYOVERRIDE_H
+#define TPCCALIB_TPCGEOMETRYOVERRIDE_H
+
+#include <fun4all/SubsysReco.h>
+
+#include <string>
+
+class PHCompositeNode;
+
+/*
+ * Overwrites the TPC envelope placement (place_x/y/z, cm) and tilt
+ * (rot_x/y/z, rad) stored in every TPCGEOMCONTAINER layer, e.g. to run
+ * reconstruction with a perfect TPC instead of the survey position that the
+ * Tracking_Geometry CDB file was produced with.
+ *
+ * Must be registered BEFORE MakeActsGeometry (i.e. before TrackingInit()),
+ * since MakeActsGeometry::InitRun builds the TPC envelope<->world transform
+ * from these values.
+ */
+class TpcGeometryOverride : public SubsysReco
+{
+ public:
+  explicit TpcGeometryOverride(const std::string &name = "TpcGeometryOverride");
+  ~TpcGeometryOverride() override = default;
+
+  int InitRun(PHCompositeNode *topNode) override;
+
+  void set_place(double x, double y, double z)
+  {
+    m_place[0] = x;
+    m_place[1] = y;
+    m_place[2] = z;
+  }
+  void set_rot(double x, double y, double z)
+  {
+    m_rot[0] = x;
+    m_rot[1] = y;
+    m_rot[2] = z;
+  }
+
+  //! zero displacement and tilt
+  void set_perfect()
+  {
+    set_place(0, 0, 0);
+    set_rot(0, 0, 0);
+  }
+
+  //! survey position, same numbers as G4TPC::tpc_survey_position in G4_TrkrSimulation.C
+  void set_survey()
+  {
+    set_place(-1.6775 / 10.0, -0.336 / 10.0, -7.1365 / 10.0);
+    set_rot(-0.00029817, 0.0014833, 0.0);
+  }
+
+ private:
+  double m_place[3]{0, 0, 0};
+  double m_rot[3]{0, 0, 0};
+};
+
+#endif
