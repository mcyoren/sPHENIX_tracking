From ccbb0cca9439c0ba5bbfb10e16ba69c6a6ebaa5e Mon Sep 17 00:00:00 2001
From: Iurii Mitrankov <iurii.mitrankov@stonybrook.edu>
Date: Wed, 14 Oct 2026 15:49:28 -0400
Subject: [PATCH] CM laser matching: configurable PHGarfield field map / TPC
 geometry, TPC geometry override module

- LaserClusterHelper/LaserClusterTruthMatcher: set_garfield_efieldmap (2D),
  set_garfield_efieldmap3d (side0, side1), set_garfield_tpc_geometry
  (HardcodedSurvey | GeomContainer | Perfect); PHGarfield instance kept
  private so several matchers can run in one job
- TpcGeometryOverride: overwrite TPC place/rot in TPCGEOMCONTAINER before
  MakeActsGeometry (perfect vs survey TPC position)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 offline/packages/tpc/LaserClusterHelper.cc    | 54 ++++++++++++++---
 offline/packages/tpc/LaserClusterHelper.h     | 22 +++++++
 .../tpccalib/LaserClusterTruthMatcher.cc      |  3 +
 .../tpccalib/LaserClusterTruthMatcher.h       | 14 +++++
 offline/packages/tpccalib/Makefile.am         |  6 +-
 .../packages/tpccalib/TpcGeometryOverride.cc  | 53 ++++++++++++++++
 .../packages/tpccalib/TpcGeometryOverride.h   | 60 +++++++++++++++++++
 7 files changed, 201 insertions(+), 11 deletions(-)
 create mode 100644 offline/packages/tpccalib/TpcGeometryOverride.cc
 create mode 100644 offline/packages/tpccalib/TpcGeometryOverride.h

diff --git a/offline/packages/tpc/LaserClusterHelper.cc b/offline/packages/tpc/LaserClusterHelper.cc
index 4d096e9..c50731b 100644
--- a/offline/packages/tpc/LaserClusterHelper.cc
+++ b/offline/packages/tpc/LaserClusterHelper.cc
@@ -55,7 +55,6 @@ void LaserClusterHelper::loadNodes(PHCompositeNode* topNode)
 
     if(m_useGarfield)
     {
-        const std::string m_spacechargefieldmap = CDBInterface::instance()->getUrl("Tpc_PolySeeding_EField");
         const auto kefffile = CDBInterface::instance()->getUrl("Tpc_PolyClusterizer_kEff");
         if (!kefffile.empty())
         {
@@ -66,14 +65,51 @@ void LaserClusterHelper::loadNodes(PHCompositeNode* topNode)
         }
 
         m_phgarfield = std::make_unique<PHGarfield>();
-        m_phgarfield->SetElectricFieldMap(m_spacechargefieldmap);
-        ROOT::Math::XYZVector Northxyz(-0.001, -0.001, 1123.109);
-        ROOT::Math::XYZVector Southxyz(-3.354, -0.673, -1137.382);
-        ROOT::Math::XYZVector center = 0.5 * (Northxyz + Southxyz);
-        center *= 0.1;  // mm to cm
-        m_phgarfield->MoveTpc(center.X(), center.Y(), center.Z());
-        m_phgarfield->RotateTpc(0, 0.001485, 0);
-        m_phgarfield->RotateTpc(0.000298, 0, 0);
+        // private instance: several matchers with different settings can run in one job
+        m_phgarfield->SetPublishToNodeTree(false);
+
+        if (!m_garfield_efieldmap3d[0].empty() && !m_garfield_efieldmap3d[1].empty())
+        {
+            m_phgarfield->SetElectricFieldMap3D(m_garfield_efieldmap3d[0], m_garfield_efieldmap3d[1]);
+        }
+        else
+        {
+            const std::string spacechargefieldmap = m_garfield_efieldmap.empty() ? CDBInterface::instance()->getUrl("Tpc_PolySeeding_EField") : m_garfield_efieldmap;
+            m_phgarfield->SetElectricFieldMap(spacechargefieldmap);
+        }
+
+        switch (m_garfield_tpc_geometry)
+        {
+        case GarfieldTpcGeometry::HardcodedSurvey:
+        {
+            ROOT::Math::XYZVector Northxyz(-0.001, -0.001, 1123.109);
+            ROOT::Math::XYZVector Southxyz(-3.354, -0.673, -1137.382);
+            ROOT::Math::XYZVector center = 0.5 * (Northxyz + Southxyz);
+            center *= 0.1;  // mm to cm
+            m_phgarfield->MoveTpc(center.X(), center.Y(), center.Z());
+            m_phgarfield->RotateTpc(0, 0.001485, 0);
+            m_phgarfield->RotateTpc(0.000298, 0, 0);
+            break;
+        }
+        case GarfieldTpcGeometry::GeomContainer:
+            // PHGarfield::LoadCDBInputs reads place/rot of TPCGEOMCONTAINER layer 20
+            m_phgarfield->SetUseSurveyGeometry(true);
+            break;
+        case GarfieldTpcGeometry::Perfect:
+            m_phgarfield->SetUseSurveyGeometry(false);
+            m_phgarfield->MoveTpc(0, 0, 0);
+            break;
+        }
+
+        std::cout << "LaserClusterHelper::loadNodes - PHGarfield config:"
+                  << " efield2D=" << m_garfield_efieldmap
+                  << " efield3D=" << m_garfield_efieldmap3d[0] << "," << m_garfield_efieldmap3d[1]
+                  << " keff=" << m_garfield_keffside0 << "," << m_garfield_keffside1
+                  << " tpcGeometry=" << static_cast<int>(m_garfield_tpc_geometry)
+                  << " cmVoltage=" << m_garfield_cmvoltage
+                  << " zeroField=" << m_garfield_zerofield
+                  << " stepns=" << m_garfield_stepns << std::endl;
+
         m_phgarfield->SetCMVoltageDefault(m_garfield_cmvoltage);
         m_phgarfield->SetZeroField(m_garfield_zerofield);
         m_phgarfield->SetSpaceChargeScaleSide0(m_garfield_keffside0);
diff --git a/offline/packages/tpc/LaserClusterHelper.h b/offline/packages/tpc/LaserClusterHelper.h
index 1732052..54d1b66 100644
--- a/offline/packages/tpc/LaserClusterHelper.h
+++ b/offline/packages/tpc/LaserClusterHelper.h
@@ -44,6 +44,25 @@ class LaserClusterHelper : public SubsysReco
     void set_garfield_keffside0(double use) { m_garfield_keffside0 = use; m_manual_garfield_keffside0 = true; }
     void set_garfield_keffside1(double use) { m_garfield_keffside1 = use; m_manual_garfield_keffside1 = true; }
     void set_garfield_stepns(double use) { m_garfield_stepns = use; }
+
+    //! 2D (axisymmetric) space-charge E-field map; empty = CDB Tpc_PolySeeding_EField
+    void set_garfield_efieldmap(const std::string &file) { m_garfield_efieldmap = file; }
+    //! side-separated 3D space-charge E-field maps; takes precedence over the 2D map
+    void set_garfield_efieldmap3d(const std::string &side0, const std::string &side1)
+    {
+      m_garfield_efieldmap3d[0] = side0;
+      m_garfield_efieldmap3d[1] = side1;
+    }
